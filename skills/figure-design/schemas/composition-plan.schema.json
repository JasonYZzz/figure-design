{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:scientific-figure:composition-plan:1",
  "title":"CompositionPlan v1",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","figure_id","route","canvas","grammar","regions","edges","style_id","status"],
  "properties":{
    "schema_version":{"const":"1.0"},"figure_id":{"type":"string","minLength":1},
    "route":{"enum":["text_structured","asset_composite","image_first","strict_scientific"]},
    "mode":{"enum":["text","mixed"]},
    "diagram_type":{"enum":["architecture","roadmap"]},
    "canvas":{"type":"object","required":["width","height"],"additionalProperties":false,"properties":{"width":{"type":"integer","minimum":400,"maximum":10000},"height":{"type":"integer","minimum":400,"maximum":10000}}},
    "grammar":{"type":"object","additionalProperties":false,"required":["primary","modifiers","asset_treatments"],"properties":{
      "primary":{"type":"string","minLength":1},"modifiers":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"asset_treatments":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
    }},
    "design_bindings":{"type":"object","additionalProperties":false,"required":["hero","paths","traces","displays"],"properties":{
      "hero":{"type":["string","null"]},"paths":{"type":"array"},"traces":{"type":"array"},"displays":{"type":"array"}}},
    "style_id":{"type":"string","minLength":1},
    "display_width_px":{"type":"integer","minimum":1,"maximum":10000},
    "theme_source":{"enum":["explicit","reference","domain_preset"]},
    "reference_design":{"type":"object","additionalProperties":false,"required":["source","features"],"properties":{
      "source":{"enum":["upload","library"]},"primary_id":{"type":"string"},
      "images":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
      "unavailable":{"type":"array","items":{"type":"string"}},
      "color_evidence":{"type":"object"},
      "features":{"type":"array","items":{"type":"object","additionalProperties":false,
        "required":["reference_id","source_bounds","target_regions","observation","check"],"properties":{
          "reference_id":{"type":"string"},"source_bounds":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}},
          "target_regions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
          "target_group":{"type":"string","minLength":1},
          "target_relations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
          "required":{"type":"boolean"},
          "observation":{"type":"string","minLength":1},"check":{"type":"string","minLength":1},
          "adaptation":{"type":"string","minLength":1}
        }}}
    }},
    "groups":{"type":"array","items":{"type":"object","additionalProperties":false,
      "required":["id","regions"],"properties":{
        "id":{"type":"string","minLength":1},
        "regions":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},
        "tone":{"$ref":"#/$defs/tone"}
      }}},
    "theme":{"type":"object","additionalProperties":false,
      "required":["paper","surface","ink","muted","accent","border","rationale"],
      "properties":{
        "paper":{"$ref":"#/$defs/color"},
        "surface":{"$ref":"#/$defs/color"},
        "ink":{"$ref":"#/$defs/color"},
        "muted":{"$ref":"#/$defs/color"},
        "accent":{"$ref":"#/$defs/color"},
        "border":{"$ref":"#/$defs/color"},
        "rationale":{"type":"string","minLength":1,"maxLength":600},
        "secondary":{"$ref":"#/$defs/color"},"tertiary":{"$ref":"#/$defs/color"}
      }},
    "regions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","role","bounds","label_instance_ids","visual_priority","text_safe"],"properties":{
      "id":{"type":"string","minLength":1},"role":{"enum":["title","hero","research_task","methods","validation","timeline","outcome","caption","support"]},
      "bounds":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}},
      "label_instance_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "asset_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "asset_fraction":{"type":"number","exclusiveMinimum":0,"maximum":0.85},
      "asset_position":{"enum":["top","left","right"]},
      "appearance":{"enum":["panel","plain","band"]},"tone":{"$ref":"#/$defs/tone"},
      "visual_priority":{"type":"integer","minimum":1,"maximum":10},
      "text_safe":{"type":"object","additionalProperties":false,"required":["min_font_px","max_lines","padding_px"],"properties":{
        "min_font_px":{"type":"number","minimum":5},"max_lines":{"type":"integer","minimum":1},"padding_px":{"type":"number","minimum":0}
      }}
    }}},
    "edges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["relation_id","source_region_id","target_region_id","line_style"],"properties":{
      "relation_id":{"type":"string"},"label_instance_id":{"type":"string"},"source_region_id":{"type":"string"},"target_region_id":{"type":"string"},"line_style":{"enum":["solid","dashed","dotted","tbar"]},"tone":{"$ref":"#/$defs/tone"}
    }}},
    "status":{"enum":["draft","validated","rejected","review_required"]}
  },
  "$defs":{"color":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$","minLength":7,"maxLength":7},
    "tone":{"enum":["accent","secondary","tertiary"]}}
}
