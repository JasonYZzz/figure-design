{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:scientific-figure:figure-content:1",
  "title":"FigureContent v1",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","figure_id","purpose","domain","study_status","sources","entities","tasks","relations","labels","label_instances"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "figure_id":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_-]+$"},
    "purpose":{"type":"string","minLength":1},
    "domain":{"type":"string","minLength":1},
    "study_status":{"enum":["planned","hypothesized","in_progress","observed","validated","mixed","unknown"]},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","document_sha256","locator","excerpt","verification"],"properties":{
      "id":{"type":"string","minLength":1},"document_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "locator":{"type":"string","minLength":1},"excerpt":{"type":"string","minLength":1},"verification":{"enum":["approved_user_brief","verified_exact","pending","rejected"]}
    }}},
    "entities":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","name","kind","source_ids"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},
      "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
    }}},
    "tasks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","title_label_id","status","source_ids"],"properties":{
      "id":{"type":"string","minLength":1},"title_label_id":{"type":"string"},
      "status":{"enum":["planned","hypothesized","in_progress","observed","validated","unknown"]},
      "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "entity_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
    }}},
    "relations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","from_id","to_id","type","evidence_state","source_ids","critical"],"properties":{
      "id":{"type":"string","minLength":1},"from_id":{"type":"string","minLength":1},"to_id":{"type":"string","minLength":1},
      "type":{"enum":["sequence","depends_on","parallel","tests","measures","supports","activates","inhibits","feedback","association"]},
      "evidence_state":{"enum":["planned","hypothesis","observed","validated","unknown"]},
      "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "critical":{"type":"boolean"},"condition_label_id":{"type":"string"}
    }}},
    "labels":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","text","kind","approved","source_ids"],"properties":{
      "id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},
      "kind":{"enum":["verbatim","approved_summary","editorial"]},
      "approved":{"type":"boolean"},"source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
    }}},
    "label_instances":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","label_id","owner_id","role","required"],"properties":{
      "id":{"type":"string","minLength":1},"label_id":{"type":"string","minLength":1},
      "owner_id":{"type":"string","minLength":1},"role":{"enum":["title","section","task","method","condition","readout","caption","legend"]},"required":{"type":"boolean"}
    }}}
  }
}
