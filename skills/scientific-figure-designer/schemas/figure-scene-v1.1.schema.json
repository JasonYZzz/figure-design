{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigureScene v1.1",
  "type": "object",
  "required": [
    "schema_version",
    "figure_id",
    "canvas",
    "source_content_hash",
    "plan_hash",
    "objects",
    "render_status",
    "renderer_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "figure_id": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source_content_ids",
          "z_index"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "image",
              "connector"
            ]
          },
          "source_content_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "z_index": {
            "type": "integer"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "label_instance_id": {
            "type": "string"
          },
          "region_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "font_size": {
            "type": "number",
            "minimum": 5
          },
          "line_height": {
            "type": "number",
            "minimum": 1
          },
          "asset_id": {
            "type": "string"
          },
          "relation_id": {
            "type": "string"
          },
          "relation_type": {
            "type": "string"
          },
          "evidence_state": {
            "type": "string"
          },
          "condition_label_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "minItems": 2
          },
          "semantic_label_bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            "then": {
              "required": [
                "bounds",
                "label_instance_id",
                "region_id",
                "text",
                "lines",
                "font_size",
                "line_height"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              }
            },
            "then": {
              "required": [
                "bounds",
                "asset_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "connector"
                }
              }
            },
            "then": {
              "required": [
                "relation_id",
                "points",
                "relation_type",
                "evidence_state"
              ]
            }
          }
        ]
      }
    },
    "render_status": {
      "enum": [
        "draft",
        "review_required"
      ]
    },
    "renderer_version": {
      "type": "string"
    }
  }
}
