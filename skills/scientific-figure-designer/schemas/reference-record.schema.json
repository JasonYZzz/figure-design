{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "path",
    "sha256",
    "width",
    "height",
    "domain_tags",
    "figure_type_tags",
    "composition_tags",
    "text_density",
    "license_state",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "dhash64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "exact_duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "figure_type_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "composition_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "text_density": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "asset_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "license_state": {
      "enum": [
        "unknown",
        "internal_reference",
        "style_only",
        "authorized_reuse",
        "restricted"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "auto_proposed",
        "human_approved",
        "blocked"
      ]
    },
    "origin": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_score": {
      "type": "number"
    }
  }
}
